# Required: https://console.typesafe.ai
TYPESAFE_API_KEY=

# Feedback after an action: ding (chime) | voice (spoken butler)
FEEDBACK=ding
# PERSONA=alfred (posh UK butler) | cowboy | plain ; USER_NAME is used in "master <name>"
PERSONA=alfred
USER_NAME=Wayne

# Optional better voice (ElevenLabs Flash, cached to disk). Defaults: alfred=George, cowboy=Bill
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=

# Hands-free: names that address the assistant; follow-up window after a command (seconds)
WAKE_WORDS=alfred,jarvis,alfie,alford,elfred
FOLLOWUP_SECONDS=8
# Unnamed utterances: 1 = let Jev judge if it's a command; gates 0..1 (0 = never ignore)
UNNAMED_COMMANDS=1
UNNAMED_MIN_ADDRESSED=0
UNNAMED_MIN_CONFIDENCE=0

# OVERLAY=0 to hide the floating transcription pill
OVERLAY=1

# Arc: never follow a tab into another space; open the page where you are instead
# ARC_STAY_IN_SPACE=1

# Keep each utterance (wav + what was heard) under ~/.cache/jev-voice/utterances so
# recognition can be measured on your own voice. Local only, newest 400, never on a call.
# SAVE_UTTERANCES=0

# While something plays out loud, a command this machine settles itself (send, pause,
# the second video...) still has to look addressed to the computer. 0..1
# LOCAL_MIN_ADDRESSED=0.4

# Endpointing. A command that is whole when said ("pause", "open spotify", "click on div")
# ends after this much silence instead of VAD_END_SILENCE_MS; checked every VAD_PROBE_MS.
# VAD_EARLY_END_MS=250
# VAD_PROBE_MS=120
# While media plays, the sentence also ends when the level falls this far below its own
# peak for VAD_END_SILENCE_MS (a video talking in the room never goes silent). 0..1
# VAD_MEDIA_DROP=0.35

# Speech recognition. whisper keeps only the END of its prompt, so the bias list is cut
# from the front to this many characters (most important terms last).
# STT_BIAS_CHARS=520
# Encoder context for whisper-server; 768 measured 108 -> 68 ms on synthetic clips only.
# WHISPER_AUDIO_CTX=768
# apple = Apple's on-device en-IN recogniser for the final pass (macOS 26+, needs swiftc;
# falls back to whisper). Measure first: scripts/bench_stt.py on your recorded utterances.
# STT_ENGINE=apple
# whisper (default) | parakeet (local Parakeet TDT on MLX, in-process) | wispr (hosted).
# Parakeet takes no prompt, so the STT_BIAS_* vocabulary never reaches it; compare it on
# your own clips first: scripts/bench_stt.py --engines whisper,parakeet
# STT_BACKEND=parakeet
# A Hugging Face id (downloaded once, then read from the cache) or a model directory.
# PARAKEET_MODEL=mlx-community/parakeet-tdt-0.6b-v2
